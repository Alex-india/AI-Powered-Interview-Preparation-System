{
  "name": "crackit-ai",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"python backend/main.py\" \"npm --prefix frontend run dev\"",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"python backend/main.py\" \"npm --prefix frontend run dev\"",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"python backend/main.py\" \"npm --prefix frontend run dev\"",
    "frontend": "npm --prefix frontend run dev",
    "backend": "python backend/main.py",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
